# Podcast Notes 前端 — Next.js 16 静态导出 + nginx 托管
# 构建阶段: node:20-alpine（npmmirror 加速）
FROM local-node-runtime:cached AS builder

# 注意: 构建期不能设 NODE_ENV=production，否则 npm ci 会跳过 devDependencies
# （tailwindcss/@tailwindcss/postcss/typescript 均为 devDependencies，构建必需）
ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

RUN npm config set registry https://registry.npmmirror.com

# 依赖分层: 先装 node_modules
COPY package.json package-lock.json ./
RUN npm config set registry https://registry.npmmirror.com && npm ci

# 构建参数: 前端鉴权 Key（构建期注入 bundle，与后端 PODCAST_NOTES_API_KEY 一致）
ARG NEXT_PUBLIC_API_KEY=""
ENV NEXT_PUBLIC_API_KEY=${NEXT_PUBLIC_API_KEY}

# 静态导出模式: 不走 rewrites，浏览器以同源相对路径请求 /api /images，
# 由运行阶段 nginx 反代到 backend:8000
ENV NEXT_STATIC_EXPORT=1 \
    NEXT_PUBLIC_API_URL=""

COPY . .
RUN npm run build

# 运行阶段: nginx 托管静态文件
FROM local-podcast-notes-frontend:before-branding

COPY --from=builder /app/out /usr/share/nginx/html
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# 健康检查: 用 127.0.0.1 规避 IPv6 解析问题
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]

